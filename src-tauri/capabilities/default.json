{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "最小权限：文件选择、本地文件读写与原生通知，不含任何 shell / 网络权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-write-file"
  ]
}
